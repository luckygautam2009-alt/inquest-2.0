PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
GEMINI_API_KEY=
ADMIN_PASSWORD=
RISK_HIGH_THRESHOLD=60
PHOTO_VALUE_CAP=5000
PHOTO_MIN_CONFIDENCE=80
# Deploy: point to a persistent disk path, e.g. /var/data/inquest.db
# DB_PATH=
RATE_LIMIT_MAX=400
# Customer accounts. Set REQUIRE_AUTH=true in production: no complaint/order without sign-in
REQUIRE_AUTH=false
SESSION_DAYS=7
# Email (optional). Without these, emails are only logged to the console and the email_outbox table.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="Inquest Support <you@gmail.com>"
ADMIN_SESSION_HOURS=12
